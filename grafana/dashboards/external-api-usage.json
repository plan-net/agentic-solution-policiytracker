          "rawSql": "SELECT\n  api_name,\n  COUNT(*) as requests,\n  AVG(latency_ms)::integer as avg_latency_ms,\n  PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY latency_ms)::integer as p95_latency_ms,\n  ROUND(100.0 * SUM(CASE WHEN status_code >= 200 AND status_code < 300 THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 1) as success_rate\nFROM external_api_requests\nWHERE timestamp > NOW() - INTERVAL '7 days'\nGROUP BY api_name\nORDER BY requests DESC",
