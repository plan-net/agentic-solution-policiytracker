# Political Monitoring Agent - Ray Serve Configuration
# This template is safe to commit - real values come from .env
# Active applications: graph-viz, claude-agent, weekly-report-sdk

proxy_location: EveryNode
http_options:
  host: 0.0.0.0
  port: 8001
grpc_options:
  port: 9000
  grpc_servicer_functions: []
logging_config:
  encoding: TEXT
  log_level: INFO
  logs_dir: null
  enable_access_log: true

applications:
# =============================================================================
# ACTIVE APPLICATIONS
# =============================================================================

# Graph Visualization Server: 2D/3D Knowledge Graph Visualization
- name: graph-viz
  route_prefix: /graph-viz
  import_path: src.graph_viz.app:graph_viz_app
  runtime_env:
    env_vars:
      PYTHONPATH: .
      LOG_LEVEL: INFO
      NEO4J_URI: ${NEO4J_URI}
      NEO4J_USERNAME: neo4j
      NEO4J_PASSWORD: ${NEO4J_PASSWORD}
      NEO4J_DATABASE: ${NEO4J_DATABASE}
      OPENAI_API_KEY: ${OPENAI_API_KEY}
  ray_actor_options:
    num_cpus: 1
    memory: 2000000000
  autoscaling_config:
    min_replicas: 1
    max_replicas: 2
    target_num_ongoing_requests_per_replica: 5

# Claude Agent: PolicyTracker with MCP Knowledge Graph Access
- name: claude-agent
  route_prefix: /claude-agent
  import_path: src.claude_agent.server:app
  runtime_env:
    env_vars:
      PYTHONPATH: .
      LOG_LEVEL: INFO
      NEO4J_URI: ${NEO4J_URI}
      NEO4J_USERNAME: neo4j
      NEO4J_PASSWORD: ${NEO4J_PASSWORD}
      NEO4J_DATABASE: ${NEO4J_DATABASE}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      SDK_COST_TRACKING_ENABLED: ${SDK_COST_TRACKING_ENABLED}
      COST_ANALYTICS_URL: ${COST_ANALYTICS_URL}
  ray_actor_options:
    num_cpus: 2
    memory: 4000000000
  autoscaling_config:
    min_replicas: 1
    max_replicas: 2
    target_num_ongoing_requests_per_replica: 5

# Weekly Report SDK: Claude Agent SDK-based Weekly Report Generation
- name: weekly-report-sdk
  route_prefix: /weekly-report-sdk
  import_path: src.flows.weekly_report_sdk.app:fast_app
  runtime_env:
    env_vars:
      PYTHONPATH: .
      LOG_LEVEL: INFO
      NEO4J_URI: ${NEO4J_URI}
      NEO4J_USERNAME: neo4j
      NEO4J_PASSWORD: ${NEO4J_PASSWORD}
      NEO4J_DATABASE: ${NEO4J_DATABASE}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      SDK_COST_TRACKING_ENABLED: ${SDK_COST_TRACKING_ENABLED}
      COST_ANALYTICS_URL: ${COST_ANALYTICS_URL}
  ray_actor_options:
    num_cpus: 2
    memory: 4000000000
  autoscaling_config:
    min_replicas: 1
    max_replicas: 2
    target_num_ongoing_requests_per_replica: 5

# Flow 1B: Bulk Auto-Delta Document Processing
- name: flow1b-bulk-auto
  route_prefix: /data-ingestion-bulk-auto
  import_path: src.flows.data_ingestion_bulk_auto.app:bulk_auto_app
  runtime_env:
    env_vars:
      PYTHONPATH: .
      LOG_LEVEL: INFO
      NEO4J_URI: ${NEO4J_URI}
      NEO4J_USERNAME: neo4j
      NEO4J_PASSWORD: ${NEO4J_PASSWORD}
      NEO4J_DATABASE: ${NEO4J_DATABASE}
      OPENAI_API_KEY: ${OPENAI_API_KEY}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
      # Graphiti LLM Provider Configuration
      GRAPHITI_LLM_PROVIDER: ${GRAPHITI_LLM_PROVIDER}
      GRAPHITI_ANTHROPIC_MODEL: ${GRAPHITI_ANTHROPIC_MODEL}
      USE_APISIX_FOR_ANTHROPIC: ${USE_APISIX_FOR_ANTHROPIC}
      USE_APISIX_FOR_EXA: ${USE_APISIX_FOR_EXA}
      USE_APISIX_FOR_DPA: ${USE_APISIX_FOR_DPA}
      USE_APISIX_FOR_BUNDESTAG: ${USE_APISIX_FOR_BUNDESTAG}
      APISIX_GATEWAY_URL: ${APISIX_GATEWAY_URL}
      LANGFUSE_PUBLIC_KEY: ${LANGFUSE_PUBLIC_KEY}
      LANGFUSE_SECRET_KEY: ${LANGFUSE_SECRET_KEY}
      LANGFUSE_HOST: http://localhost:3001
  ray_actor_options:
    num_cpus: 3
    memory: 3000000000
  autoscaling_config:
    min_replicas: 1
    max_replicas: 3
    target_num_ongoing_requests_per_replica: 1

