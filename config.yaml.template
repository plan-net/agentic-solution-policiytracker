# Political Monitoring Agent - Ray Serve Configuration
# This template is safe to commit - real values come from .env

proxy_location: EveryNode
http_options:
  host: 0.0.0.0
  port: 8001
grpc_options:
  port: 9000
  grpc_servicer_functions: []
logging_config:
  encoding: TEXT
  log_level: INFO
  logs_dir: null
  enable_access_log: true

applications:
# Flow 1B: Bulk Auto-Delta Document Processing
# Active - High-performance document batch processing
- name: flow1b-bulk-auto
  route_prefix: /data-ingestion-bulk-auto
  import_path: src.flows.data_ingestion_bulk_auto.app:bulk_auto_app
  runtime_env:
    env_vars:
      PYTHONPATH: .
      LOG_LEVEL: INFO

      # Neo4j Configuration
      NEO4J_URI: ${NEO4J_URI}
      NEO4J_USER: ${NEO4J_USER}
      NEO4J_PASSWORD: ${NEO4J_PASSWORD}
      NEO4J_DATABASE: ${NEO4J_DATABASE}

      # API Keys (required)
      OPENAI_API_KEY: ${OPENAI_API_KEY}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}

      # Langfuse (optional observability)
      LANGFUSE_PUBLIC_KEY: ${LANGFUSE_PUBLIC_KEY}
      LANGFUSE_SECRET_KEY: ${LANGFUSE_SECRET_KEY}
      LANGFUSE_HOST: http://localhost:3001

  ray_actor_options:
    num_cpus: 3
    memory: 3000000000
  autoscaling_config:
    min_replicas: 1
    max_replicas: 3
    target_num_ongoing_requests_per_replica: 1

# Flow 1D: Raw Document Auto-Conversion + Graphiti Processing
# Active - Document conversion and processing pipeline
- name: flow1d-raw-converter
  route_prefix: /raw-converter
  import_path: src.flows.documents_raw_converter.app:app
  runtime_env:
    env_vars:
      PYTHONPATH: .
      LOG_LEVEL: INFO

      # Neo4j Configuration
      NEO4J_URI: ${NEO4J_URI}
      NEO4J_USER: ${NEO4J_USER}
      NEO4J_PASSWORD: ${NEO4J_PASSWORD}
      NEO4J_DATABASE: ${NEO4J_DATABASE}

      # API Keys (required)
      OPENAI_API_KEY: ${OPENAI_API_KEY}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}

      # Langfuse (optional observability)
      LANGFUSE_PUBLIC_KEY: ${LANGFUSE_PUBLIC_KEY}
      LANGFUSE_SECRET_KEY: ${LANGFUSE_SECRET_KEY}
      LANGFUSE_HOST: http://localhost:3001

  ray_actor_options:
    num_cpus: 2
    memory: 2500000000
  autoscaling_config:
    min_replicas: 1
    max_replicas: 3
    target_num_ongoing_requests_per_replica: 1