# Chat Server: LLM Interface for Knowledge Graph
- name: chat-server
  route_prefix: /chat
  import_path: src.chat.server.app:chat_app
  runtime_env:
    env_vars:
      PYTHONPATH: .
      LOG_LEVEL: INFO

      # Neo4j (required for Graphiti)
      NEO4J_URI: bolt://localhost:7687
      NEO4J_USERNAME: neo4j
      NEO4J_PASSWORD: password123
      NEO4J_DATABASE: politicamonitoring.v2

      # API Key (required)
      OPENAI_API_KEY: ${OPENAI_API_KEY}

  ray_actor_options:
    num_cpus: 1
    memory: 2000000000  # 2GB
  autoscaling_config:
    min_replicas: 1
    max_replicas: 2
    target_num_ongoing_requests_per_replica: 5

# Graph Visualization Server: 2D/3D Knowledge Graph Visualization
- name: graph-viz
  route_prefix: /graph-viz
  import_path: src.graph_viz.app:graph_viz_app
  runtime_env:
    env_vars:
      PYTHONPATH: .
      LOG_LEVEL: INFO

      # Neo4j Configuration
      NEO4J_URI: ${NEO4J_URI}
      NEO4J_USER: ${NEO4J_USER}
      NEO4J_PASSWORD: ${NEO4J_PASSWORD}
      NEO4J_DATABASE: ${NEO4J_DATABASE}

      # API Key (required for text-to-cypher)
      OPENAI_API_KEY: ${OPENAI_API_KEY}

  ray_actor_options:
    num_cpus: 1
    memory: 2000000000  # 2GB
  autoscaling_config:
    min_replicas: 1
    max_replicas: 2
    target_num_ongoing_requests_per_replica: 5

