# ============================================================================
# PROCESSING SETTINGS
# ============================================================================

# === Document Processing ===
PROCESSING_TIMEOUT_SECONDS=600
MAX_DOCUMENT_SIZE_MB=50
PRIORITY_THRESHOLD=70.0
CONFIDENCE_THRESHOLD=0.7

# === Document Chunk Limiting (Cost Reduction) ===
# Limits the number of chunks per document to reduce LLM calls in Graphiti.
# Each chunk triggers ~5-10 sequential LLM calls via add_episode().
# 0 = unlimited (default). Set to e.g. 20 to cap chunks per document.
MAX_CHUNKS_PER_DOCUMENT=0

# Enable adaptive chunk sizing: dynamically increases chunk size to fit
# large documents within MAX_CHUNKS_PER_DOCUMENT budget (preserves all content).
ADAPTIVE_CHUNK_SIZE_ENABLED=true

# Maximum token size per chunk when adaptive sizing is applied.
# Prevents unreasonably large chunks that could degrade extraction quality.
MAX_ADAPTIVE_TOKENS=8000

# Fallback when adaptive sizing still exceeds MAX_CHUNKS_PER_DOCUMENT:
# "smart_sample" = keep first 30% + last 20% + sampled middle, drop the rest
# "truncate" = keep first N chunks only, drop the rest
# "embed_only" = first N chunks get full extraction, overflow saved as embed-only episodes
# "smart_sample_embed" = smart-selected chunks (first/last/sampled middle) get full extraction,
#   all remaining chunks saved as embed-only episodes (recommended for content preservation)
CHUNK_LIMIT_FALLBACK_STRATEGY=smart_sample

# === LLM Prompt Cache Optimization (Cost Reduction) ===
# Optimizes prompt structure for LLM provider caching:
# - OpenAI: Moves schema to developer message for automatic prefix caching (50% discount)
# - Anthropic: Injects cache_control breakpoints on schema blocks (90% discount)
# Set to false to use standard Graphiti LLM clients without cache optimization.
ENABLE_PROMPT_CACHE_OPTIMIZATION=true

# === Ray Configuration ===
# Ray handles distributed processing
RAY_ADDRESS=auto  # Use local Ray cluster
RAY_NUM_CPUS=4    # Adjust based on your machine

# ============================================================================
