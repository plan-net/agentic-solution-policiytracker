# Political Monitoring Agent v0.2.0 Configuration
# Copy this file to .env and configure your API keys and settings

# ============================================================================
# CORE CONFIGURATION
# ============================================================================

# === Environment ===
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================================
# DATABASE & SERVICES  
# ============================================================================

# === PostgreSQL (for Langfuse only) ===
# PostgreSQL runs in Docker via docker-compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# === Neo4j (for Graphiti Knowledge Graph) ===
# Neo4j runs in Docker via docker-compose
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=politicamonitoring.v2
GRAPHITI_GROUP_ID=political_monitoring_v2

# === Graphiti LLM Provider Configuration ===
# Configure which LLM provider to use for Graphiti entity extraction
# Options: openai, anthropic
GRAPHITI_LLM_PROVIDER=anthropic

# Anthropic model for Graphiti (when GRAPHITI_LLM_PROVIDER=anthropic)
# Options: claude-sonnet-4-5-latest, claude-haiku-4-5-latest, claude-3-5-sonnet-20241022
GRAPHITI_ANTHROPIC_MODEL=claude-sonnet-4-5-latest

# Enable APISIX routing for Anthropic (for cost tracking)
# Set to true if you have APISIX configured with Anthropic route
USE_APISIX_FOR_ANTHROPIC=false

# APISIX Gateway URL (for LLM and external API routing)
APISIX_GATEWAY_URL=http://localhost:9080

# Enable APISIX routing for external APIs (for request tracking)
USE_APISIX_FOR_EXA=false
USE_APISIX_FOR_DPA=false
USE_APISIX_FOR_BUNDESTAG=false

# SDK Cost Tracking (for Claude Agent SDK sessions)
SDK_COST_TRACKING_ENABLED=true
COST_ANALYTICS_URL=http://localhost:8090

# ============================================================================
# LLM & AI CONFIGURATION
# ============================================================================

# === LLM Settings ===
LLM_ENABLED=false  # Set to true when you have API keys configured
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# === OpenAI Configuration ===
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4

# === Anthropic Configuration ===
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# === Observability Provider Selection ===
# Choose which observability platform to use for LLM tracing
# Options:
#   - "langwatch"  : Use LangWatch only (legacy)
#   - "langfuse"   : Use LangFuse only (recommended - native Claude Agent SDK support)
#   - "both"       : Use both simultaneously (for migration/validation)
OBSERVABILITY_PROVIDER=langfuse

# === LangFuse v3 (LLM Observability - RECOMMENDED) ===
# LangFuse provides native Claude Agent SDK auto-instrumentation
# SETUP INSTRUCTIONS:
# 1. Run: just services-up (starts LangFuse v3 stack)
# 2. Visit: http://localhost:3001
# 3. Sign up with any email/password
# 4. Create organization and project
# 5. Go to Settings → API Keys → Create new API key
# 6. Replace the values below with your actual keys

LANGFUSE_PUBLIC_KEY=pk-lf-your-actual-public-key-from-ui
LANGFUSE_SECRET_KEY=sk-lf-your-actual-secret-key-from-ui
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_ENABLE_TRACING=true
# Timeout in seconds for Langfuse API requests (increase for slow networks/high latency)
# Default: 30. For production with network issues, try 60-120
LANGFUSE_TIMEOUT=30
# Background flush interval in seconds (batches traces to reduce network calls)
# Default: 5. Increase for Ray workers to reduce connection overhead
LANGFUSE_FLUSH_INTERVAL=5

# === LangWatch (Legacy - being deprecated) ===
# NOTE: LangWatch is being replaced by LangFuse. Set OBSERVABILITY_PROVIDER=langwatch
# only if you need backward compatibility during migration.
# SETUP INSTRUCTIONS:
# 1. Run: just langwatch-up
# 2. Visit: http://localhost:5560
# 3. Create account and project
# 4. Go to Settings → API Keys → Generate new API key
# 5. Replace LANGWATCH_API_KEY below with your key

ENABLE_LANGWATCH=false
LANGWATCH_API_KEY=your-langwatch-api-key-from-ui
LANGWATCH_ENDPOINT=http://langwatch-server:5560
LANGWATCH_NEXTAUTH_SECRET=changeme-langwatch-secret-generate-random-string
LANGWATCH_API_TOKEN_JWT_SECRET=changeme-api-token-jwt-secret-generate-random-string

# ============================================================================
# NEWS COLLECTION (ETL)
# ============================================================================

# === News Collectors ===
# Configure one or both API keys for automated news collection

# Apify (RSS headlines and summaries)
# Get your API key from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Exa.ai (full article content - RECOMMENDED)
# Get your API key from: https://dashboard.exa.ai/api-keys
EXA_API_KEY=your_exa_api_key_here

# DPA News API (German press agency - dpa-IQ-Retriever)
# Get your API key from: https://article-retriever.iq.dpa-ai-hub.de/docs
DPA_API_KEY=your_dpa_api_key_here

# Default collector: exa_direct (recommended), apify, exa, or dpa
NEWS_COLLECTOR=dpa

# Multi-collector mode: comma-separated list of collectors to run (order matters)
# First collector's articles take priority for deduplication
# Options: dpa, exa_direct, exa, apify
# Example: NEWS_COLLECTORS=dpa,exa_direct runs both DPA and EXA
# Leave empty or unset to use single NEWS_COLLECTOR above
NEWS_COLLECTORS=

# === Bundestag DIP API Configuration (Flow 5) ===
# German Bundestag parliamentary data collection
# API Documentation: https://dip.bundestag.de/documents/information_der_bundestagsverwaltung_zur_api.pdf

# Bundestag DIP API base URL
BUNDESTAG_API_URL=https://search.dip.bundestag.de/api/v1/

# API Key (valid until 05/2026)
# NOTE: This API key expires in May 2026. Obtain new key from: https://dip.bundestag.de/
BUNDESTAG_API_KEY=OSOegLs.PR2lwJ1dwCeje9vTj7FPOt3hvpYKtwKkhw
BUNDESTAG_DIP_API_KEY=${BUNDESTAG_API_KEY}

# Default legislative period (Wahlperiode)
# 20 = Current period (2021-2025)
BUNDESTAG_DEFAULT_WAHLPERIODE=20

# Batch size for API requests (max 100 per request)
BUNDESTAG_BATCH_SIZE=100

# Rate limiting (requests per second to avoid API throttling)
BUNDESTAG_RATE_LIMIT_PER_SECOND=5

# Collection timeframe for initialization (days to look back)
BUNDESTAG_INITIALIZATION_DAYS=90

# === ETL Initialization Settings ===
# Configure historical data collection for first-time setup

# Days to look back on FIRST RUN (initialization)
# Common values: 30 (1 month), 90 (3 months), 180 (6 months)
ETL_INITIALIZATION_DAYS=30

# Days to look back on REGULAR DAILY RUNS
# Typically 1 for daily collection, 2-3 for safety overlap
ETL_DAILY_COLLECTION_DAYS=1

# === Policy Collection Settings (Flow 1) ===
# Policy documents collected weekly for regulatory landscape analysis

# Days to collect on FIRST RUN for policy landscape
# Longer period recommended: 90-180 days for comprehensive policy context
POLICY_INITIALIZATION_DAYS=90

# Days to collect on REGULAR WEEKLY RUNS
# Weekly schedule covers 7 days, but can extend for safety
POLICY_COLLECTION_DAYS=7

# Query limits to respect Exa API
POLICY_MAX_RESULTS_PER_QUERY=10
POLICY_MAX_CONCURRENT_QUERIES=3

# How it works:
# - News (Flow 2): Daily collection, client-specific
# - Policy (Flow 1): Weekly collection, regulatory landscape  
# - First time: Collects INITIALIZATION_DAYS worth of documents
# - After that: Collects DAILY/WEEKLY_COLLECTION_DAYS worth
# - Status tracked per collector type automatically
# - Reset with: just etl-reset <collector>

